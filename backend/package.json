{
  "name": "athleticos-api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node --stack-size=4096 ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/jwt": "8.0.1",
    "@fastify/swagger": "8.15.0",
    "@fastify/swagger-ui": "3.1.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "fastify": "4.29.1",
    "pino-pretty": "13.1.3",
    "resend": "6.9.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.19.28",
    "@vitest/coverage-v8": "^1.6.1",
    "prisma": "5.22.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "1.6.1"
  }
}
