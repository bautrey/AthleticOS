# AthleticOS backend environment
# Copy to .env and fill in. Only DATABASE_URL and JWT_SECRET are required —
# everything else has a working default (see src/config.ts).

# --- Required (no default; app and tests will not start without these) ---
DATABASE_URL=postgresql://athleticos:athleticos@localhost:5434/athleticos
JWT_SECRET=change-me-to-something-at-least-32-characters-long

# --- Server ---
PORT=8000
NODE_ENV=development
PUBLIC_URL=http://localhost:3005
APP_URL=http://localhost:3005

# --- Blackbaud SKY API ---
# mock = serve canned TCA-shaped fixtures from client-fixtures/ (no credentials
#        needed, no network calls). This is the default and is what the demo runs on.
# live = call the real SKY API. Requires APP_SECRET + SUBSCRIPTION_KEY below,
#        and an authorized environment (see docs/blackbaud-sky-prep.md).
BLACKBAUD_MODE=mock

# Public OAuth client_id — safe to commit, already defaulted in src/config.ts.
BLACKBAUD_APP_ID=e060cf3f-d079-469b-824b-43e2f0b0dfca

# Required only when BLACKBAUD_MODE=live. Stored in macOS keychain:
#   security find-generic-password -a burkestudio -s blackbaud-sky-client-secret -w
#   security find-generic-password -a burkestudio -s blackbaud-sky-subscription-key -w
BLACKBAUD_APP_SECRET=
BLACKBAUD_SUBSCRIPTION_KEY=

BLACKBAUD_REDIRECT_URI=http://localhost:8003/auth/blackbaud/callback

# SKY does NOT use per-API scopes — access follows the authorizing user's
# permissions. offline_access is required to receive a refresh_token.
BLACKBAUD_SCOPES=offline_access

# --- Fortium Ideas widget (optional; feedback proxy) ---
IDEAS_API_URL=https://ideas.fortiumsoftware.com
IDEAS_API_KEY=

# --- Email (optional) ---
RESEND_API_KEY=
